# ─────────────────────────────────────────────────────────────
# KHADE — root environment template.
# Copy to .env (local) and to each app's .env.local as needed.
# NEVER commit real values. Service-role keys are server-only.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
# Live project: "khadeapp" (ref qfxdatptvypebnntzvhh). Anon/service keys are
# secret — copy them from the dashboard, do NOT commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://qfxdatptvypebnntzvhh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps (Maps JavaScript API + Places API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Stripe (Developers → API keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Firebase Cloud Messaging (push) + Analytics — server credentials
FCM_SERVER_KEY=your-fcm-server-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# AI provider (pluggable; OpenAI by default). V2 features only — see README.
OPENAI_API_KEY=sk-xxx
LLM_PROVIDER=openai

# Platform configuration (see packages/shared/src/constants.ts for defaults)
KHADE_PLATFORM_COMMISSION_PCT=15
KHADE_DEFAULT_CURRENCY=USD
